<Window x:Class="Emutastic.Views.YmirEmulatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        Icon="pack://application:,,,/Assets/emutastic-logo.ico"
        Width="854" Height="520"
        WindowStartupLocation="CenterOwner"
        KeyDown="Window_KeyDown"
        KeyUp="Window_KeyUp"
        Closing="Window_Closing">
    <Window.Resources>
        <DropShadowEffect x:Key="WindowShadow"
                          BlurRadius="30"
                          ShadowDepth="0"
                          Opacity="0.8"
                          Color="{StaticResource ShadowColor}"/>
    </Window.Resources>

    <Border Background="Black"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Effect="{StaticResource WindowShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Background="{DynamicResource BgSecondaryBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="GameTitleText"
                           Grid.Column="0"
                           FontFamily="{StaticResource PrimaryFont}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Top">
                    <Button Style="{StaticResource WindowsCaptionButton}"
                            Click="MinBtn_Click"
                            ToolTip="Minimize"
                            Content="&#xE921;"/>
                    <Button Style="{StaticResource WindowsCaptionButton}"
                            Click="MaxBtn_Click"
                            ToolTip="Maximize"
                            Content="&#xE922;"/>
                    <Button Style="{StaticResource WindowsCloseCaptionButton}"
                            Click="CloseBtn_Click"
                            ToolTip="Close"
                            Content="&#xE8BB;"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Background="Black">
                <Image x:Name="GameScreen"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>

                <TextBlock x:Name="StatusText"
                           Text="Starting Ymir..."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource PrimaryFont}"
                           FontSize="14"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Grid>

            <Border Grid.Row="2"
                    Background="{DynamicResource BgSecondaryBrush}"
                    Padding="10,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="FooterText"
                               Grid.Column="0"
                               Text="Ymir embedded"
                               FontFamily="{StaticResource PrimaryFont}"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal">
                        <Button x:Name="PauseResumeBtn"
                                Width="28"
                                Height="24"
                                Margin="0,0,6,0"
                                Padding="0"
                                FontFamily="Segoe MDL2 Assets"
                                Content="&#xE769;"
                                ToolTip="Pause"
                                Click="PauseResumeBtn_Click"/>
                        <Button Width="28"
                                Height="24"
                                Margin="0,0,6,0"
                                Padding="0"
                                FontFamily="Segoe MDL2 Assets"
                                Content="&#xE72C;"
                                ToolTip="Reset"
                                Click="ResetBtn_Click"/>
                        <Button Width="28"
                                Height="24"
                                Margin="0,0,6,0"
                                Padding="0"
                                FontFamily="Segoe MDL2 Assets"
                                Content="&#xE74E;"
                                ToolTip="Save State"
                                Click="SaveStateBtn_Click"/>
                        <Button Width="28"
                                Height="24"
                                Padding="0"
                                FontFamily="Segoe MDL2 Assets"
                                Content="&#xE895;"
                                ToolTip="Load Latest State"
                                Click="LoadLatestStateBtn_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
